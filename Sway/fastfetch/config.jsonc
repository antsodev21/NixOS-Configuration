{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "chafa", // O "iterm" / "sixel" / "chafa" según tu terminal
    "source": ".config/fastfetch/Iconos/OneShot-Lightbulb.png",
    "width": 28,
    "height": 12,
    "padding": {
      "top": 1,
      "left": 2
    }
  },

  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "  󱄅 OS"
    },
    {
      "type": "kernel",
      "key": "   KRN"
    },
    {
      "type": "uptime",
      "key": "  󱎫 UPT"
    },
    {
      "type": "packages",
      "key": "  󰏖 PKG"
    },
    "break",
    {
      "type": "wm",
      "key": "   WM"
    },
    {
      "type": "terminal",
      "key": "   TRM"
    },
    {
      "type": "shell",
      "key": "  󰞷 SH"
    },
    "break",
    {
      "type": "cpu",
      "key": "  󰻠 CPU"
    },
    {
      "type": "gpu",
      "key": "  󰢮 GPU"
    },
    {
      "type": "memory",
      "key": "  󰍛 RAM"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
